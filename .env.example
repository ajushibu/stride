# Copy to .env (local) or add these in Vercel -> Settings -> Environment Variables.

# Claude API key (server only, never sent to the browser)
ANTHROPIC_API_KEY=your-api-key-here

# Supabase (same project and account as your other apps is fine)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Only this account may use the app, so nobody else can spend your API credit
ALLOWED_EMAIL=you@example.com

# Optional
# STRIDE_MODEL=claude-sonnet-5-5
# Local file mode only (leave SUPABASE_URL unset): protect the app with a passcode
# APP_PASSCODE=
